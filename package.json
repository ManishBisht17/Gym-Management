{
  "name": "gymflow",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {"dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"", "dev:server": "npm --workspace server run dev", "dev:client": "npm --workspace client run dev", "build": "npm run build --workspace server && npm run build --workspace client", "test": "npm run test --workspace server"},
  "devDependencies": {"concurrently": "^9.1.2"}
}
